# Normalize line endings: store text as LF in the repo, check out native.
* text=auto eol=lf

# Binary assets — never normalize.
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.webm binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
