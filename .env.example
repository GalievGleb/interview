# Database
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Dev mode — без оплаты, все функции доступны (выключить в production)
DEV_SKIP_SUBSCRIPTION=true

# Stripe (можно оставить пустым пока не подключаете оплату)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# YooKassa (можно оставить пустым)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# AI providers (server-side only)
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=
YANDEX_API_KEY=

# App
API_PORT=3000
API_URL=http://localhost:3000
DESKTOP_PROTOCOL=interview
CORS_ORIGIN=*
