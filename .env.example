# ⚠️ Этот файл описывает окружение СПЯЩЕГО NestJS-слоя (apps/api — биллинг/SaaS,
# десктопом не используется, см. docs/adr/0001-backend-architecture.md).
# Основной бэкенд десктопа (apps/api-py) настраивается в apps/api-py/.env
# (см. apps/api-py/.env.example) и через UI приложения.

# Database
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Dev mode — без оплаты, все функции доступны (выключить в production)
DEV_SKIP_SUBSCRIPTION=true

# Stripe (можно оставить пустым пока не подключаете оплату)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BASIC_MONTHLY_PRICE_ID=
STRIPE_BASIC_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# YooKassa (можно оставить пустым)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# AI providers (server-side only)
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=
YANDEX_API_KEY=

# Transactional account email (server-side only)
RESEND_API_KEY=
AUTH_MAIL_FROM=SkillCue <no-reply@skill-cue.ru>
AUTH_CODE_SECRET=change-me-auth-code-secret-min-32-chars
DEVICE_ID_SECRET=change-me-device-id-secret-min-32-chars
GOOGLE_OAUTH_CLIENT_ID=
LICENSE_PRIVATE_KEY_HEX=

# Dedicated account API (Alpha first; keep bound to loopback behind HTTPS proxy)
ACCOUNT_API_HOST=127.0.0.1
ACCOUNT_API_PORT=8788
JWT_ACCESS_EXPIRES_SEC=900

# Public desktop build metadata. The OAuth client ID is public, not a secret.
SKILLCUE_ACCOUNT_API_URL=https://skill-cue.ru/account
SKILLCUE_GOOGLE_OAUTH_CLIENT_ID=

# App
API_PORT=3000
API_URL=http://localhost:3000
DESKTOP_PROTOCOL=skillcue
CORS_ORIGIN=*
