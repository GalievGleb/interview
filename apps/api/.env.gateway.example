# Пример конфига гейтвея лицензий. На сервере лежит как /opt/skillcue/gateway.env
# (chmod 600). Заполняется deploy.py автоматически; здесь — справка по переменным.

# Порт гейтвея (nginx проксирует сюда с домена; наружу закрыть после домена).
GATEWAY_PORT=8787

# Redis для учёта токенов и rate-limit.
REDIS_URL=redis://127.0.0.1:6379

# Апстрим-ключ издателя: С ЭТОГО КЛЮЧА идут запросы ВСЕХ покупателей.
# Без него /v1/chat/completions вернёт 503 (issue/usage работают и без него).
OPENROUTER_API_KEY=sk-or-...

# Апстрим-ключ Яндекс SpeechKit v3: с этого ключа идёт распознавание речи ВСЕХ
# покупателей через /gateway/stt/stream (см. gateway-stt.gateway.ts). Без него
# десктоп получит "STT gateway is not configured" при выборе Yandex SpeechKit.
YANDEX_API_KEY=

# (опц.) Месячные бюджеты STT в СЕКУНДАХ аудио по тарифу — каждая секунда стоит
# денег в Yandex. Дефолты: trial 20 мин, basic 5 ч, max 20 ч (см.
# gateway-stt-quota.util.ts, PLAN_STT_SECONDS_BUDGETS).
# GATEWAY_STT_SECONDS_TRIAL=1200
# GATEWAY_STT_SECONDS_BASIC=18000
# GATEWAY_STT_SECONDS_MAX=72000

# Секрет для POST /gateway/issue (выпуск лицензий). Генерится deploy.py в
# apps/api/deploy/.admin_secret — храни в тайне.
GATEWAY_ADMIN_SECRET=change-me

# Приватный ключ подписи лицензий (тот же, что apps/api-py/.license_signing_key).
# Нужен только для выпуска ключей; проверка ключей работает и без него.
LICENSE_PRIVATE_KEY_HEX=...

# (опц.) Публичный ключ проверки — по умолчанию зашит тот же, что в api-py.
# LICENSE_PUBLIC_KEY_HEX=...

# (опц.) Свой апстрим вместо OpenRouter.
# GATEWAY_UPSTREAM_BASE=https://openrouter.ai/api/v1
