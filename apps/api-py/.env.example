# === AI providers (BYOK, dev only — в проде через secure storage) ===
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini

# === Speech-to-text ===
DEEPGRAM_API_KEY=
STT_ENABLED=true
STT_LANGUAGE=multi

# === Backend ===
API_HOST=127.0.0.1
API_PORT=8000

# === Embeddings ===
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# === Limits ===
MAX_CHAT_REQUESTS_PER_MIN=20
MAX_STT_MINUTES_PER_SESSION=60

# === Privacy ===
PRIVACY_MODE=false
LOG_LEVEL=info
CORS_ORIGINS=*
