{
  "name": "@interview/desktop",
  "version": "0.0.7",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "dist": "pnpm dist:full",
    "dist:app": "pnpm build && electron-builder",
    "build:backend": "cd ../api-py && pyinstaller skillcue-backend.spec",
    "predownload:model": "cd ../api-py && python predownload_models.py",
    "predownload:model:tiny": "cd ../api-py && python predownload_models.py tiny",
    "dist:full": "pnpm build:backend && pnpm predownload:model:tiny && pnpm build && electron-builder",
    "dist:offline": "pnpm predownload:model && pnpm dist:full",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@interview/shared": "workspace:*",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.interview.assistant",
    "productName": "Skillcue",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../api-py/dist/skillcue-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../api-py/dist/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SkillCue-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "GalievGleb",
      "repo": "ScillCue",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Skillcue",
        "schemes": [
          "interview"
        ]
      }
    ]
  }
}
