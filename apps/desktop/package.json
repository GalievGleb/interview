{
  "name": "@interview/desktop",
  "version": "0.1.13",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "assets:installer": "python build/make_icon.py",
    "prebuild": "pnpm assets:installer",
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:dev": "vite build --mode devbuild && tsc -p tsconfig.electron.json",
    "build:alpha": "vite build --mode alphabuild && tsc -p tsconfig.electron.json",
    "dist": "pnpm dist:full",
    "dist:app": "pnpm build && electron-builder",
    "dist:dev:app": "pnpm build:dev && electron-builder --config electron-builder.dev.cjs --win nsis --publish never",
    "dist:dev": "pnpm build:backend && pnpm dist:dev:app",
    "dist:alpha:app": "pnpm build:alpha && electron-builder --config electron-builder.alpha.cjs --win nsis --publish never",
    "dist:alpha": "pnpm build:backend && pnpm dist:alpha:app",
    "build:backend": "cd ../api-py && .venv\\Scripts\\pyinstaller.exe -y skillcue-backend.spec",
    "verify:dev:overlay": "python ../../tools/verify_dev_overlay.py",
    "verify:dev:voice": "python ../../tools/verify_dev_voice_overlay.py",
    "verify:dev:ui": "node tools/verify-installed-dev-ui.mjs",
    "verify:source:overlay-ui": "node tools/verify-overlay-source-ui.mjs",
    "verify:dev:screen": "python ../../tools/verify_screen_code_task.py --fixture-order",
    "verify:alpha:screen": "python ../../tools/verify_screen_code_task.py --channel alpha --structured-screen --real-interview-regressions --repetitions 1",
    "verify:dev:interviews": "python ../../tools/real_interview_acceptance.py --manifest ../../output/interview-replay/acceptance-cases.json --report ../../output/interview-replay/acceptance-report.json",
    "release:dev:verified": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/install_and_verify_dev.ps1",
    "release:alpha:verified": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/install_and_verify_alpha.ps1",
    "dist:full": "pnpm build:backend && pnpm build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@interview/shared": "workspace:*",
    "cheerio": "1.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "39.8.10",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.interview.assistant",
    "productName": "SkillCue",
    "electronVersion": "39.8.10",
    "afterPack": "build/applyWindowsDpiManifest.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/branding/skillcue-app-icon-512.png"
    ],
    "extraResources": [
      {
        "from": "../api-py/dist/skillcue-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/branding/skillcue-app-icon-1024.png",
      "category": "public.app-category.productivity",
      "artifactName": "SkillCue-macOS-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SkillCue uses the microphone only when you start voice practice or a live interview session.",
        "NSAudioCaptureUsageDescription": "SkillCue captures system audio only while you run the live interview overlay."
      }
    },
    "dmg": {
      "title": "SkillCue ${version}",
      "iconSize": 96,
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SkillCue-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "GalievGleb",
      "repo": "SkillCue",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "SkillCue",
        "schemes": [
          "skillcue"
        ]
      }
    ]
  }
}
